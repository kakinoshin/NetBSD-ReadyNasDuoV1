#	$NetBSD$
#
# PADRE_NFS -- PADRE with its root on NFS, from tools/mkusbroot.sh -n.
#
# Everything is fixed here: the LAN's DHCP server knows nothing of NFS roots,
# and the kernel's own DHCP client got no answer (dhcpcd from userland does).
# The address is the one the LAN's DHCP server leases to the NAS.
#

include 	"arch/padre/conf/PADRE"

no options 	MEMORY_DISK_IS_ROOT
no options 	MEMORY_DISK_ROOT_SIZE
no options 	MEMORY_DISK_HOOKS
no pseudo-device	md

options 	NFS_BOOT_TCP	# servers no longer offer NFS over UDP
options 	NFS_BOOT_BOOTSTATIC
options 	NFS_BOOTSTATIC_MYIP="\"192.168.0.104\""
options 	NFS_BOOTSTATIC_MASK="\"255.255.255.0\""
options 	NFS_BOOTSTATIC_GWIP="\"192.168.0.1\""
options 	NFS_BOOTSTATIC_SERVER="\"192.168.0.119:/srv/padre\""

no config	netbsd
config		netbsd	root on gm0 type nfs
