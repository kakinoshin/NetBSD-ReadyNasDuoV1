#	$NetBSD$
#
# PADRE -- ReadyNAS Duo v1, started from RAIDiator by padre_go.ko.
#

include 	"arch/padre/conf/std.padre"

maxusers	8

options 	DIAGNOSTIC
options 	HZ=100

# Root file system from tools/mkroot.sh, placed in the kernel by build-kernel.sh.
options 	MEMORY_DISK_HOOKS
options 	MEMORY_DISK_IS_ROOT
options 	MEMORY_DISK_ROOT_SIZE=32768

file-system	FFS

config		netbsd	root on ? type ?

mainbus0	at root

pcic0		at mainbus0
pci0		at pcic0 bus ?
uhci*		at pci? dev ? function ?
ehci*		at pci? dev ? function ?
usb*		at uhci?
usb*		at ehci?
uhub*		at usb?
uhub*		at uhub? port ?
umass*		at uhub? port ? configuration ? interface ?
scsibus*	at umass?
sd*		at scsibus? target ? lun ?

pseudo-device	md
pseudo-device	pcons
