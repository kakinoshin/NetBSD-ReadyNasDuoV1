#	$NetBSD$

# Makefile for NetBSD
#
# This makefile is constructed from a machine description:
#	config machineid
# Most changes should be made in the machine description
#	/sys/arch/padre/conf/``machineid''
# after which you should do
#	config machineid
# Machine generic makefile changes should be made in
#	/sys/arch/padre/conf/Makefile.padre
# after which config should be rerun for all machines of that type.

MACHINE_ARCH=	sparc
USETOOLS?=	no
NEED_OWN_INSTALL_TARGET?=no
.include <bsd.own.mk>

##
## (1) port identification
##
PADRE=		$S/arch/padre
GENASSYM_CONF=	${PADRE}/padre/genassym.cf

##
## (2) compile settings
##
# The core has no FPU and sdiv is unreliable (bug 940): stay at V7 so that
# multiply and divide go through libkern. Assembler may still use ASIs.
CFLAGS+=	-mno-fpu -mcpu=v7
AFLAGS+=	-x assembler-with-cpp

##
## (3) libkern and compat
##
OPT_MODULAR=	%MODULAR%

##
## (4) local objects, compile rules, and dependencies
##
MD_OBJS=	locore.o
MD_CFILES=
MD_SFILES=	${PADRE}/padre/locore.S

locore.o: ${PADRE}/padre/locore.S assym.h
	${NORMAL_S}

##
## (5) link settings
##
TEXTADDR?=	90000000
EXTRA_LINKFLAGS=	-X
KERNLDSCRIPT?=	${PADRE}/conf/kern.ldscript
LINKFORMAT=	-n

##
## (6) port specific target dependencies
##
# config's "machine padre sparc" would also pull in files.sparc, so the shared
# headers get their <sparc/...> link here.
.BEGIN:
	@rm -f sparc && ln -s $S/arch/sparc/include sparc

##
## (7) misc settings
##

##
## (8) config(8) generated machinery
##
%INCLUDES

%OBJS

%CFILES

%SFILES

%LOAD

%RULES

##
## (9) port independent kernel machinery
##
.include "$S/conf/Makefile.kern.inc"

##
## (10) Appending make options.
##
%MAKEOPTIONSAPPEND
